  "work": [
    "Generated deterministic short click samples with silent gaps.",
    "Created Wwise Play event, click sound, dry reference, stereo Auxiliary Bus and wet-only PD ShareSet.",
    "Replaced sine MetaSound with looping Wave Player through the compiled PD node.",
    "Created persistent map, two real streamed room maps, GameInstance return subsystem and interactive HUD.",
    "Spawned sound owners inside streamed levels, unloaded those levels, forced full garbage collection and observed source destruction.",
    "Recorded actual Wwise host output, Unreal MetaSound output and native Unreal return; verified stereo delay timing and fading echoes."
  ],
  "issues_and_fixes": [
    {
      "issue": "A sustained sine wave concealed the audible repeats; Wwise and the native Submix had no listening demos.",
      "fix": "Use short clicks with silent gaps; provide separate MetaSound, Wwise send-return and native Submix streaming demonstrations."
    },
    {
      "issue": "Adding a sublevel changed the current editor level and put the controller in a streamed room.",
      "fix": "Select the persistent map explicitly before placing the controller; assert each sound actor belongs to its streamed room."
    },
    {
      "issue": "A weak actor pointer can remain valid after level removal until garbage collection.",
      "fix": "Force full garbage collection during the transition and confirm the actor is actually destroyed before the next room loads."
    },
    {
      "issue": "Repeated Wwise setup appended extra effect slots.",
      "fix": "Replace the list and retain exactly one PD delay instance on the auxiliary return."
    },
    {
      "issue": "Unreal automatic non-realtime rendering ran independently of game time; early headless captures were silent or excessively long.",
      "fix": "Disable automatic rendering and its scheduler in verification mode, step audio once per fixed game tick, and enable background audio."
    },
    {
      "issue": "The return was loaded too early in GameInstance initialization; the native runtime chain was empty although the asset looked correct in the editor.",
      "fix": "Defer loading to a playable world, hold both return and preset in the subsystem, explicitly activate its chain once, and reuse it for every send."
    },
    {
      "issue": "Unattended asset recreation failed for existing assets.",
      "fix": "Update the generated maps in place and preserve existing MetaSound edits on reruns."
    },
    {
      "issue": "PowerShell process status was unavailable after waiting on a released process handle.",
      "fix": "Retain the process handle before waiting so the reusable runner reads the correct exit status."
    }
  ],
